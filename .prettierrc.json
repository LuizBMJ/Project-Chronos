{
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": false,

	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,

	"trailingComma": "all",
	"quoteProps": "as-needed",

	"bracketSpacing": true,
	"arrowParens": "always",

	"endOfLine": "lf",

	"htmlWhitespaceSensitivity": "css",
	"proseWrap": "preserve",

	"embeddedLanguageFormatting": "auto"
}
